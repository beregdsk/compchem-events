---
// The events map: events that share topics, a series or an organizer, drawn
// close together. Spec: docs/superpowers/specs/2026-09-28-event-graph-design.md.
import Base from '../layouts/Base.astro';
import GraphFigure from '../components/GraphFigure.astro';
import ViewSwitch from '../components/ViewSwitch.astro';
import { loadEvents } from '../lib/events';
import { buildEventGraph } from '../lib/event-graph';

const graph = buildEventGraph(loadEvents());
const LEGEND = [
  ['circle', 'Conference'],
  ['square', 'Workshop'],
  ['diamond', 'School'],
  ['triangle', 'Symposium'],
  ['ring', 'Webinar or hackathon'],
] as const;
---

<Base
  title="Graph view"
  description="A graph of computational chemistry events, linked by shared topics, series and organizers."
  path="/graph/"
  section="events"
>
  <div class="page-head">
    <h1>Graph view</h1>
    <ViewSwitch current="graph" list="/" />
  </div>
  <p class="muted">
    Events that share topics, a series or an organizer are linked; nearby events are similar.
  </p>

  {graph.nodes.length === 0 && <p class="muted">No events to map yet.</p>}
  {graph.nodes.length > 0 && (
    <GraphFigure
      graph={graph}
      label="Map of similar events. Each event links to its page."
      legend={LEGEND}
      currentNote="Upcoming or ongoing; past events are dimmed"
    />
  )}
</Base>
