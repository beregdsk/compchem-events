---
// The masthead plate: a Monte-Carlo point cloud of a real 3d(z²) orbital.
//
// Astro renders this at build time, so the visitor gets static markup and the
// sampling never runs in a browser. The dots take their colour from the two
// phase tokens, which is why the plate is inline SVG rather than a background
// image: an external file could not follow the theme.
import { FIELD_SIZE, orbitalLayers } from '../lib/orbital';

/**
 * Tuned against the size the plate actually draws at. Fewer and the lobes stop
 * reading as lobes; many more and the masthead costs more than the page it
 * heads. See docs/decisions.md for the measurements.
 */
const DOT_COUNT = 2600;

const layers = orbitalLayers(DOT_COUNT);
---

<svg
  class="field"
  viewBox={`0 0 ${FIELD_SIZE} ${FIELD_SIZE}`}
  preserveAspectRatio="xMaxYMid meet"
  aria-hidden="true"
  focusable="false"
>
  {layers.map((layer) => (
    <path
      d={layer.d}
      fill="none"
      stroke={layer.phase === 1 ? 'var(--lobe-pos)' : 'var(--lobe-neg)'}
      stroke-width={layer.width}
      stroke-linecap="round"
      opacity={layer.opacity}
    />
  ))}
</svg>
