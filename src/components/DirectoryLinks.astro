---
// The site's directories besides events, boxed like the list/graph switch so
// they sit apart from the page's action row.
const links = [
  { href: '/positions/', label: 'Positions' },
  { href: '/groups/', label: 'Groups' },
];
---

<nav class="view-switch mono" aria-label="Directories">
  {links.map((l) => (
    <a href={l.href}>{l.label}</a>
  ))}
</nav>
